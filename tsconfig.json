{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/core/finance": ["./src/capabilities/billing/finance/index.ts"],
      "@/core/finance/*": ["./src/capabilities/billing/finance/*"],
      "@/core/commerce": ["./src/capabilities/commerce/facade/index.ts"],
      "@/core/commerce/*": ["./src/capabilities/commerce/facade/*"],
      "@/core/product": ["./src/capabilities/commerce/catalog/index.ts"],
      "@/core/product/*": ["./src/capabilities/commerce/catalog/*"],
      "@/core/inventory": ["./src/capabilities/commerce/stock/index.ts"],
      "@/core/inventory/*": ["./src/capabilities/commerce/stock/*"],
      "@/core/sales": ["./src/capabilities/commerce/saleLedger/index.ts"],
      "@/core/sales/*": ["./src/capabilities/commerce/saleLedger/*"],
      "@/core/loyalty": ["./src/capabilities/commerce/loyalty/index.ts"],
      "@/core/loyalty/*": ["./src/capabilities/commerce/loyalty/*"],
      "@/core/availability": ["./src/capabilities/scheduling/availability/index.ts"],
      "@/core/availability/*": ["./src/capabilities/scheduling/availability/*"],
      "@/core/capacity": ["./src/capabilities/scheduling/capacity/index.ts"],
      "@/core/capacity/*": ["./src/capabilities/scheduling/capacity/*"],
      "@/core/calendar": ["./src/capabilities/scheduling/calendar/index.ts"],
      "@/core/calendar/*": ["./src/capabilities/scheduling/calendar/*"],
      "@/core/waitlist": ["./src/capabilities/booking/waitlist/index.ts"],
      "@/core/waitlist/*": ["./src/capabilities/booking/waitlist/*"],
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "supabase/functions",
    "dist",
    "node_modules",
    "android",
    "ios",
    "test-results",
    "playwright-report"
  ]
}
