{
  "name": "moa-academy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "vite build",
    "build:mobile": "npm run build:web && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:capacitor": "npm run icons:generate && npx @capacitor/assets generate --assetPath resources --iconBackgroundColor '#4f46e5' --splashBackgroundColor '#4f46e5' && node scripts/sync-pwa-manifest.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:bulk-import": "tsx src/core/students/bulkImport/studentBulkImport.test.ts",
    "test:rls-audit": "tsx scripts/rls-org-isolation-audit.ts",
    "test:rls-membership-policy": "tsx scripts/rls-membership-policy.test.ts",
    "test:rls-membership-escalation": "tsx scripts/rls-membership-escalation-audit.ts",
    "test:multi-role-helpers": "tsx scripts/multiRolePermissionHelpers.test.ts",
    "test:auth-hijack-audit": "tsx scripts/auth-providers-hijack-audit.ts",
    "test:e2e": "playwright test",
    "test:deeplink": "tsx src/core/platform/deepLinkParser.test.ts",
    "test:timetable-placement": "node --experimental-test-module-mocks --import tsx src/modules/piano/components/schedule/pianoTimetablePlacement.test.ts",
    "test:invoice-dedupe": "tsx src/core/finance/invoiceDedupe.test.ts",
    "test:today-lesson-teacher": "tsx src/modules/piano/components/lessons/todayLessonSaveTeacherId.test.ts",
    "test:manual-attendance-class": "tsx src/core/academy/components/students/detail/studentManualAttendanceClass.test.ts",
    "test:create-sale-atomic": "tsx src/core/sales/createSaleAtomic.test.ts",
    "test:create-sale-return-atomic": "tsx src/core/sales/createSaleReturnAtomic.test.ts",
    "test:textbook-core-sale-link": "tsx src/modules/piano/services/textbookCoreSaleLink.test.ts",
    "test:org-context-resolve": "tsx src/core/organizations/resolveOrganizationContext.test.ts",
    "test:pilates-booking-validate": "tsx src/modules/pilates/components/bookings/validateBookingCreate.test.ts",
    "test:textbook-sale-legacy": "tsx src/modules/piano/services/textbookSaleLegacy.test.ts",
    "test:textbook-sale-compensate": "tsx src/modules/piano/services/textbookSaleService.compensate.test.ts",
    "test:sync-persist-helpers": "tsx src/services/adapters/sync/persistHelpers.test.ts",
    "test:hydrate-modules": "tsx src/services/adapters/hydrateModules.test.ts",
    "test:textbook-sale-db-it": "tsx scripts/textbookSaleDbIntegration.test.ts",
    "test:skin-retail-migrate": "tsx src/modules/skin/services/skinRetailCatalogMigrate.test.ts",
    "test:sale-return-points": "tsx src/core/loyalty/saleReturnPointReverse.test.ts",
    "test:point-atomic": "tsx src/core/loyalty/pointEarnRedeemAtomic.test.ts",
    "test:sale-redeem-consistency": "tsx src/core/sales/saleRedeemConsistency.test.ts",
    "test:stock-movement-atomic": "tsx src/core/inventory/applyStockMovementAtomic.test.ts",
    "test:commerce-db-it": "tsx scripts/commerceDbIntegration.test.ts",
    "test:retail-staff-sale-perm": "tsx scripts/retailStaffSalePermissions.test.ts",
    "test:retail-revenue": "tsx src/modules/retail/services/retailRevenueAggregate.test.ts",
    "test:commerce-unit": "npm run test:create-sale-atomic && npm run test:create-sale-return-atomic && npm run test:point-atomic && npm run test:sale-redeem-consistency && npm run test:stock-movement-atomic && npm run test:multi-role-helpers",
    "supabase:types": "echo 'Run Supabase MCP generate_typescript_types and update src/lib/supabase/database.types.ts'"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
