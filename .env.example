# ────────────────────────────────────────────────────────────
# 모아(Moa) 환경 변수 예제
# ────────────────────────────────────────────────────────────
# 사용법:
#   1. 이 파일을 `.env.local`로 복사
#   2. 실제 값으로 치환 (절대 커밋하지 마세요)
#   3. 프로덕션 환경 변수는 Vercel 대시보드에서 설정
#
# 자세한 내용: docs/ENV_SETUP.md

# ── Supabase ──────────────────────────────────────────────
# Supabase 프로젝트 URL (ap-northeast-2)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon public key (RLS로 보호됨)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-here"

# ── 앱 설정 ───────────────────────────────────────────────
# 학부모 초대 이메일 링크용 (선택)
VITE_APP_URL="https://your-app.vercel.app"

# 스토어·법적 고지 (선택 — 미설정 시 brand.json 기본값 사용)
VITE_APP_NAME="모두의 아카데미 모아"
VITE_APP_SHORT_NAME="아카데미 모아"
VITE_SUPPORT_EMAIL="support@moa.kr"
VITE_LEGAL_ENTITY_NAME="모두의 아카데미 모아"
# 스토어 등록 URL: /privacy, /terms, /support (docs/STORE_REVIEW.md 참고)

# ── Edge Function (Supabase Secrets) ──────────────────────
# send-parent-invitation에서 사용
# RESEND_API_KEY="re_..."
# INVITE_FROM_EMAIL="모두의 아카데미 모아 <noreply@yourdomain.com>"

# ── 모바일 앱 (Capacitor) ─────────────────────────────────
# 프로덕션 웹 URL — PWA·초대 링크·OAuth redirect에 사용
# VITE_APP_URL="https://app.moa.kr"
#
# Supabase Auth → Redirect URLs에 추가:
#   https://app.moa.kr
#   com.moa.academy://login-callback   (네이티브, iOS/Android)
#
# Android: android/ — Android Studio에서 AAB 빌드
# iOS: ios/ — Mac + Xcode에서 Archive (Linux에서는 프로젝트만 생성)
# 자세한 절차: docs/MOBILE.md

# ── 레거시 / 선택 사항 ────────────────────────────────────
# 다음은 과거 AI Studio 스캐폴딩에서 남은 항목입니다.
# 현재 Moa에서 사용하지 않으면 삭제 가능합니다.
# GEMINI_API_KEY="your-gemini-api-key"
# APP_URL="https://your-app-url.run.app"
